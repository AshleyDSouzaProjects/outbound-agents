# Copy to .env and fill in. NEVER commit .env.
# Only the ingestion machine needs these; the analysis side needs none of them.

# Screener.in — log in, then copy the 'sessionid' cookie from your browser
SCREENER_SESSION=

# Optional: pin the corpus location. Defaults to walking up for the TANSTAAFL root.
# TANSTAAFL_ROOT=/Users/you/tanstaafl/TANSTAAFL
